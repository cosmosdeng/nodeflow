{
  "name": "nodeflow",
  "productName": "NodeFlow",
  "version": "0.4.0-next.4",
  "description": "跨平台通用节点式流程绘图工具",
  "main": "dist-electron/main.js",
  "author": {
    "name": "cosmosdeng",
    "email": "dycosmos@gmail.com"
  },
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && tsc -p tsconfig.electron.json",
    "build:electron": "tsc -p tsconfig.electron.json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src electron mcp-server/src",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"electron/**/*.ts\" \"mcp-server/src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"electron/**/*.ts\" \"mcp-server/src/**/*.ts\"",
    "start": "bun run build && electron .",
    "dist": "bun run build && electron-builder",
    "dist:mac": "bun run build && electron-builder --mac",
    "dist:win": "bun run build && electron-builder --win",
    "dist:linux": "bun run build && electron-builder --linux"
  },
  "dependencies": {
    "@xyflow/react": "^12.3.5",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.0.3",
    "vitest": "^4.1.11",
    "zod": "^4.5.4"
  },
  "build": {
    "appId": "com.nodeflow.app",
    "productName": "NodeFlow",
    "directories": {
      "output": "release"
    },
    "icon": "assets/icon.png",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/**/*"
    ],
    "fileAssociations": [
      {
        "ext": "nodeflow",
        "name": "NodeFlow 项目",
        "description": "NodeFlow 项目文件",
        "role": "Editor",
        "mimeType": "application/json",
        "icon": "assets/icon.png"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "cosmosdeng",
      "repo": "nodeflow"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.graphics-design"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "signAndEditExecutable": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Graphics"
    }
  }
}
